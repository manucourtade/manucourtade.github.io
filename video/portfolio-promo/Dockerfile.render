# Reproducible local HyperFrames renderer for machines without system FFmpeg.
FROM node:22.23.4-bookworm-slim

# Debian packages avoid downloading a separate static FFmpeg build from GitHub.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg chromium fonts-liberation fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

ENV HYPERFRAMES_BROWSER_PATH=/usr/bin/chromium \
    FFMPEG_PATH=/usr/bin/ffmpeg \
    FFPROBE_PATH=/usr/bin/ffprobe

RUN npm install --global hyperframes@0.8.210
WORKDIR /workspace
ENTRYPOINT ["hyperframes"]
